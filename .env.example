# Скопируйте файл в .env и замените примеры своими значениями.
# --- Основные настройки ---
# Токен бота из Discord Developer Portal (раздел Bot).
DC_TOKEN=your_discord_token_here
# Имена пользователей Discord через запятую, не отображаемые имена.
# Администраторы сервера имеют доступ независимо от этого списка.
ALLOWED_USERS=atagaev
# Подключение к PostgreSQL: пользователь:пароль@хост:порт/имя_базы.
DATABASE_URL=postgresql+asyncpg://postgres:pass@localhost:5432/discord
# Имя схемы PostgreSQL; обычно public.
DATABASE_SCHEMA=public
# ID канала: Discord → «Копировать ID канала».
SCREENSHOT_CHANNEL_ID=your_screenshot_channel_id_here

# --- Настройки AI ---
# API-ключ вашего AI-провайдера.
AI_TOKEN=your_ai_token_here
# Базовый URL OpenAI-совместимого API провайдера.
AI_PROVIDER_URL=https://api.polza.ai/api/v1